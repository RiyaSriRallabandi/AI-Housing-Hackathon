# Runtime LLM — one pair of settings for all six agents. Do not put model
# names inside agent modules.

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Fallback when Groq TPD/TPM is exhausted (not gemini-2.5-flash / not 3.8-flash):
# LLM_PROVIDER=google_gemini
# LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Optional retry tuning (429 backoff)
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2.0
