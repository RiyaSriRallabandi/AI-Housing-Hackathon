# Secrets — never commit. Use .env locally only.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Local data caches (source log is committed; raw downloads are not)
data/raw/
data/cache/
!data/cache/.gitkeep
!data/raw/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
